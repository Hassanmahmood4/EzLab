# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
.Python
*.so

# Model weights & caches (download from Hugging Face / Kaggle)
.cache/
mlx_models/
*.gguf
models/*.gguf
!models/README.md
!models/.gitignore
!models/.gitkeep

# Generated / local runtime outputs
outputs/
storage/
*.pdf
!templates/**
plot.png
resolved_report.json
preview.png

# Dataset zip bundles (jsonl is source of truth)
data/*.zip
data/colab_dataset.zip
data/kaggle_dataset.zip

# Local tooling binaries
bin/typst
bin/

# OS / IDE / agents
.DS_Store
.idea/
.vscode/
.claude/
.impeccable/
*.crdownload
docs/*.crdownload

# Keep adapters tracked once trained; ignore mid-train checkpoints
adapters/checkpoint_*/
adapters/*.pt
adapters/*.bin
adapters/*.safetensors

# Frontend
web/node_modules/
web/.next/
web/*.tsbuildinfo
web/out/

# Demo / media scratch (keep repo lean)
outputs/demo/
*.webm
*.mov
# Allow intentional assets + the official demo reel
!assets/**/*.png
!assets/**/*.jpg
!docs/demo/ezlab_demo.mp4
